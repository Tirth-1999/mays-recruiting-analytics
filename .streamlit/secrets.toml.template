# Streamlit Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to version control!

[google_oauth]
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
# For production (Streamlit Cloud), use your app URL:
redirect_uri = "https://mays-recruiting-analytics.streamlit.app"
# For local development, use:
# redirect_uri = "http://localhost:8501"

[resend]
api_key = "YOUR_RESEND_API_KEY"

[email]
contact_email = "tirth.shah@tamu.edu"
from_email = "onboarding@resend.dev"

[gemini]
api_key = "YOUR_GEMINI_API_KEY"
# Get your free API key from: https://makersuite.google.com/app/apikey

[chat]
rate_limit_requests = 10
rate_limit_window = 60
max_conversation_history = 5
token_limit_per_query = 1000
